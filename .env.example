# --- Core ---
DATABASE_URL=postgresql://rukwaride:rukwaride@localhost:5433/rukwaride
REDIS_URL=redis://localhost:6380
API_PORT=3001
APP_BASE_URL=http://localhost:3000
DEFAULT_LOCALE=sw

# --- Auth ---
# Either inline PEM content or a *_PATH pointing at a PEM file.
JWT_PRIVATE_KEY_PATH=infra/keys/dev-jwt-private.pem
JWT_PUBLIC_KEY_PATH=infra/keys/dev-jwt-public.pem
JWT_ACCESS_TTL_S=900
OTP_PEPPER=dev-otp-pepper-change-me

# --- Providers (mock at dev; operator supplies real credentials) ---
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=RUKWARIDE
PUSH_PROVIDER=mock
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=

# --- Geo / routing ---
# OSRM road routing. Empty → haversine x1.4 fallback (straight lines). To enable
# real road-following routes/ETAs, run infra/osrm/setup.sh then set:
OSRM_URL=http://localhost:5000
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Web map (apps/web). Default is OpenFreeMap vector tiles (clear roads, no key).
# Override with a MapLibre vector style URL, or set NEXT_PUBLIC_TILE_URL for a
# raster {z}/{x}/{y} provider instead.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
ETA_TRAFFIC_FACTOR=1.2

# --- Dispatch (spec §7; server-side timers only) ---
DISPATCH_OFFER_TTL_S=25
DISPATCH_LOCK_TTL_S=30
DISPATCH_MAX_CANDIDATES=5
DISPATCH_MAX_SEARCH_S=90
DISPATCH_RADII_KM=1,3,7
LOCATION_STALE_EXCLUDE_S=30
LOCATION_OFFLINE_S=120
# Namespace isolation for BullMQ + Socket.io adapter (only override when running
# a second, non-cooperating instance against the same Redis, e.g. tests):
QUEUE_PREFIX=bull
SOCKET_ADAPTER_KEY=socket.io

# --- Object storage (documents; later phase) ---
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_BUCKET=

# --- LATRA (operator-supplied; mock until then) ---
LATRA_OAUTH_URL=
LATRA_API_URL=
LATRA_CLIENT_ID=
LATRA_CLIENT_SECRET=

# --- Observability ---
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_DRIVER=

# --- Staff seed credentials (dev; change before seeding prod) ---
SEED_ADMIN_PASSWORD=
SEED_DISPATCHER_PASSWORD=
# LATRA client binding: mock | real (real needs LATRA_* above)
LATRA_CLIENT=mock
# --- Hardening (phase 6) ---
LOG_LEVEL=info
WEB_ORIGINS=http://localhost:3000
