{
  "name": "rukwaride",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:api": "pnpm --filter @rukwaride/api start:dev",
    "sim": "pnpm --filter @rukwaride/scripts sim",
    "db:migrate": "pnpm --filter @rukwaride/api prisma:migrate",
    "db:seed": "pnpm --filter @rukwaride/api prisma:seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w5hq-g745-h8pq"
      ]
    },
    "overrides": {
      "ioredis": "^5.11.1",
      "postcss@<8.5.18": "^8.5.18",
      "fast-uri@<3.1.6": "^3.1.6",
      "fast-uri@>=4.0.0 <4.1.3": "^4.1.3",
      "sharp@<0.35.4": "^0.35.4",
      "find-my-way@<9.7.0": "^9.7.0",
      "socket.io-parser@<4.2.7": "^4.2.7",
      "js-yaml@<4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "@xmldom/xmldom@>=0.7 <0.9.12": "^0.9.12",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "decode-uri-component@<=0.4.2": "^0.5.0",
      "fastify@<5.12.1": "^5.12.1"
    }
  }
}
